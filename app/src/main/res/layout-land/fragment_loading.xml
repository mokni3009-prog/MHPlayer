<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/color_background"
    android:padding="32dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="60dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/logo_play"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="MH Player"
            android:textSize="64sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressRing"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="48dp"
        android:max="100"
        android:progress="62"
        android:progressDrawable="@drawable/progress_ring" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="360dp"
        android:layout_height="8dp"
        android:layout_marginTop="24dp"
        android:max="100"
        android:progress="62"
        android:progressDrawable="@drawable/bg_progress_bar"
        style="?android:attr/progressBarStyleHorizontal" />

    <TextView
        android:id="@+id/percentText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="62%"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Chargement des films…"
        android:textSize="28sp"
        android:textColor="@color/color_text_primary" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="48dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/stepLiveIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/color_success_green" />

            <TextView
                android:id="@+id/stepLiveLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Chaînes"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/color_success_green" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="64dp">

            <TextView
                android:id="@+id/stepVodIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textSize="28sp"
                android:textColor="@color/color_primary_red" />

            <TextView
                android:id="@+id/stepVodLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Films"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/color_primary_red" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="64dp">

            <TextView
                android:id="@+id/stepSeriesIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○"
                android:textSize="28sp"
                android:textColor="@color/color_text_disabled" />

            <TextView
                android:id="@+id/stepSeriesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Séries"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_disabled" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="@color/color_primary_red"
        android:visibility="gone" />

    <Button
        android:id="@+id/retryButton"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="Réessayer"
        android:visibility="gone"
        style="@style/Widget.MHPlayer.Button.Primary" />

    <TextView
        android:id="@+id/loadingFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Ma playlist"
        android:textSize="20sp"
        android:textColor="@color/color_text_disabled" />

</LinearLayout>
