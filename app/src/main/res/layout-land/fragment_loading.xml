<?xml version="1.0" encoding="utf-8"?>
<!-- Loading — responsive (v1.3): ScrollView + ConstraintLayout with a packed
     vertical chain, so logo + ring + bar + status + steps stay centered and
     complete on any screen height (phone landscape ~360-411dp up to TV 720dp).
     Sizes come from the screen-size dimens buckets. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:id="@+id/logoRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.5">

            <ImageView
                android:layout_width="@dimen/logo_icon"
                android:layout_height="@dimen/logo_icon"
                android:src="@drawable/logo_play"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/logo_text_margin"
                android:text="MH Player"
                android:textSize="@dimen/text_loading_logo"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressRing"
            android:layout_width="@dimen/loading_ring_size"
            android:layout_height="@dimen/loading_ring_size"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="62"
            android:progressDrawable="@drawable/progress_ring"
            app:layout_constraintTop_toBottomOf="@id/logoRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="62"
            android:progressDrawable="@drawable/bg_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            app:layout_constraintTop_toBottomOf="@id/progressRing"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_max="@dimen/loading_bar_width" />

        <TextView
            android:id="@+id/percentText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="62%"
            android:textSize="@dimen/text_percent"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary"
            app:layout_constraintTop_toBottomOf="@id/progressBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Chargement des films…"
            android:textSize="@dimen/text_status"
            android:textColor="@color/color_text_primary"
            app:layout_constraintTop_toBottomOf="@id/percentText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/stepsRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/statusText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/stepLiveIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textSize="@dimen/text_steps"
                    android:textStyle="bold"
                    android:textColor="@color/color_success_green" />

                <TextView
                    android:id="@+id/stepLiveLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Chaînes"
                    android:textSize="@dimen/text_steps"
                    android:textStyle="bold"
                    android:textColor="@color/color_success_green" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/steps_gap">

                <TextView
                    android:id="@+id/stepVodIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textSize="@dimen/text_steps"
                    android:textColor="@color/color_primary_red" />

                <TextView
                    android:id="@+id/stepVodLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Films"
                    android:textSize="@dimen/text_steps"
                    android:textStyle="bold"
                    android:textColor="@color/color_primary_red" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/steps_gap">

                <TextView
                    android:id="@+id/stepSeriesIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="○"
                    android:textSize="@dimen/text_steps"
                    android:textColor="@color/color_text_disabled" />

                <TextView
                    android:id="@+id/stepSeriesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Séries"
                    android:textSize="@dimen/text_steps"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_disabled" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="@dimen/text_error"
            android:textColor="@color/color_primary_red"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/stepsRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="8dp"
            android:text="Réessayer"
            android:visibility="gone"
            style="@style/Widget.MHPlayer.Button.Primary"
            app:layout_constraintTop_toBottomOf="@id/errorText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/loadingFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:text="Ma playlist"
            android:textSize="@dimen/text_loading_footer"
            android:textColor="@color/color_text_disabled"
            app:layout_constraintTop_toBottomOf="@id/retryButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
