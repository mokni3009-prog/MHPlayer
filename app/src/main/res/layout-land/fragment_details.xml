<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/color_background">

    <com.mhplayer.app.ui.SidebarView
        android:id="@+id/sidebar"
        android:layout_width="@dimen/sidebar_width"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="@dimen/content_margin_left"
        android:paddingEnd="@dimen/content_margin"
        android:paddingTop="@dimen/content_margin_left">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/detailsPoster"
                    android:layout_width="@dimen/details_poster_width"
                    android:layout_height="@dimen/details_poster_height"
                    android:scaleType="centerCrop"
                    android:background="@drawable/poster_placeholder"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/content_margin_left">

                    <TextView
                        android:id="@+id/detailsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mystères de Paris"
                        android:textSize="@dimen/text_details_title"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/detailsMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/form_gap"
                        android:text="2024 • Drame • 2 saisons"
                        android:textSize="@dimen/text_meta"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_secondary" />

                    <TextView
                        android:id="@+id/detailsPlot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/form_margin_top"
                        android:text="Un inspecteur parisien traque un secret enfoui au cœur de la capitale."
                        android:textSize="@dimen/text_plot"
                        android:textColor="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/hbbtvNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/form_gap"
                        android:text="HbbTV interactif non disponible sur cet appareil"
                        android:textSize="@dimen/text_body"
                        android:textColor="@color/color_text_muted"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/content_margin">

                        <Button
                            android:id="@+id/playButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/button_primary_height"
                            android:text="▶  Lecture"
                            android:paddingStart="@dimen/content_margin_left"
                            android:paddingEnd="@dimen/content_margin_left"
                            android:focusable="true"
                            style="@style/Widget.MHPlayer.Button.Primary" />

                        <Button
                            android:id="@+id/infoButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/button_primary_height"
                            android:layout_marginStart="@dimen/form_gap"
                            android:text="Plus d'infos"
                            android:focusable="true"
                            style="@style/Widget.MHPlayer.Button.Secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/seasonTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:text="Saison 1"
                android:textSize="@dimen/text_section_title"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episodeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/form_gap"
                android:layout_marginBottom="@dimen/content_margin" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:gravity="center"
                android:text="Aucun contenu"
                android:textSize="@dimen/text_empty"
                android:textColor="@color/color_text_muted"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
