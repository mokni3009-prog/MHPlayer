<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/color_background">

    <com.mhplayer.app.ui.SidebarView
        android:id="@+id/sidebar"
        android:layout_width="230dp"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingStart="40dp"
        android:paddingEnd="32dp"
        android:paddingTop="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/detailsPoster"
                    android:layout_width="330dp"
                    android:layout_height="388dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/poster_placeholder"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="40dp">

                    <TextView
                        android:id="@+id/detailsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mystères de Paris"
                        android:textSize="56sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/detailsMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="2024 • Drame • 2 saisons"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_secondary" />

                    <TextView
                        android:id="@+id/detailsPlot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Un inspecteur parisien traque un secret enfoui au cœur de la capitale."
                        android:textSize="20sp"
                        android:textColor="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/hbbtvNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="HbbTV interactif non disponible sur cet appareil"
                        android:textSize="18sp"
                        android:textColor="@color/color_text_muted"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="32dp">

                        <Button
                            android:id="@+id/playButton"
                            android:layout_width="wrap_content"
                            android:layout_height="64dp"
                            android:text="▶  Lecture"
                            android:paddingStart="40dp"
                            android:paddingEnd="40dp"
                            android:focusable="true"
                            style="@style/Widget.MHPlayer.Button.Primary" />

                        <Button
                            android:id="@+id/infoButton"
                            android:layout_width="wrap_content"
                            android:layout_height="64dp"
                            android:layout_marginStart="16dp"
                            android:text="Plus d'infos"
                            android:focusable="true"
                            style="@style/Widget.MHPlayer.Button.Secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/seasonTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:text="Saison 1"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episodeList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="Aucun contenu"
                android:textSize="20sp"
                android:textColor="@color/color_text_muted"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
