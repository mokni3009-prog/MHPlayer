<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/color_background"
    android:padding="@dimen/screen_padding">

    <com.mhplayer.app.ui.SidebarView
        android:id="@+id/sidebar"
        android:layout_width="@dimen/sidebar_width"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/content_margin"
        android:layout_marginBottom="@dimen/content_margin" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/content_margin_left"
        android:layout_marginEnd="@dimen/content_margin_end">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_height"
                android:background="@drawable/poster_placeholder">

                <ImageView
                    android:id="@+id/heroImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_scrim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/hero_padding"
                    android:paddingEnd="@dimen/hero_padding">

                    <TextView
                        android:id="@+id/heroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Film à la une"
                        android:textSize="@dimen/text_hero_title"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/heroSynopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/form_gap"
                        android:text="Un thriller haletant dans une ville sous la pluie. Trahisons, secrets et enquête nocturne."
                        android:textSize="@dimen/text_body"
                        android:textColor="#D8D8DC"
                        android:maxLines="2" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/form_margin_top">

                        <Button
                            android:id="@+id/heroPlayButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/button_height"
                            android:text="▶  Lecture"
                            android:focusable="true"
                            style="@style/Widget.MHPlayer.Button.Primary" />

                        <Button
                            android:id="@+id/heroInfoButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/button_height"
                            android:layout_marginStart="@dimen/form_gap"
                            android:text="Plus d'infos"
                            android:focusable="true"
                            style="@style/Widget.MHPlayer.Button.Secondary" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rowsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/form_margin_top" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:gravity="center"
                android:text="Aucun contenu"
                android:textSize="@dimen/text_empty"
                android:textColor="@color/color_text_muted"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
