<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/color_background"
    android:padding="@dimen/screen_padding">

    <com.mhplayer.app.ui.SidebarView
        android:id="@+id/sidebar"
        android:layout_width="@dimen/sidebar_width"
        android:layout_height="match_parent" />

    <!-- Bouquets column -->
    <LinearLayout
        android:layout_width="@dimen/bouquet_column_width"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/column_gap"
        android:orientation="vertical"
        android:background="@color/color_panel_dark">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/content_margin"
            android:layout_marginTop="@dimen/form_margin_top"
            android:text="Bouquets"
            android:textSize="@dimen/text_column_title"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bouquetList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/form_gap"
            android:nextFocusRight="@+id/channelList" />
    </LinearLayout>

    <!-- Chaînes column -->
    <LinearLayout
        android:layout_width="@dimen/channel_column_width"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/column_gap"
        android:orientation="vertical"
        android:background="@color/color_panel_mid">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/content_margin"
            android:layout_marginTop="@dimen/form_margin_top"
            android:text="Chaînes"
            android:textSize="@dimen/text_column_title"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/form_gap"
            android:nextFocusLeft="@+id/bouquetList"
            android:nextFocusRight="@+id/videoContainer" />
    </LinearLayout>

    <!-- Video preview column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/column_gap"
        android:orientation="vertical"
        android:background="@color/color_panel_video">

        <FrameLayout
            android:id="@+id/videoContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="@dimen/video_margin"
            android:background="@drawable/bg_card"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@+id/channelList">

            <androidx.media3.ui.PlayerView
                android:id="@+id/playerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:surface_type="surface_view"
                app:use_controller="false" />

            <org.videolan.libvlc.util.VLCVideoLayout
                android:id="@+id/vlcLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/videoLoading"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/mini_row_padding"
            android:paddingEnd="@dimen/mini_row_padding">

            <ImageView
                android:id="@+id/miniPlayButton"
                android:layout_width="@dimen/mini_play_size"
                android:layout_height="@dimen/mini_play_size"
                android:background="@color/color_focus_bg"
                android:padding="6dp"
                android:src="@drawable/ic_play"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/miniCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/form_gap"
                android:text="00:00"
                android:textSize="@dimen/text_mini_time"
                android:textColor="@color/color_text_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/miniTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="@dimen/text_mini_time"
                android:textColor="@color/color_text_primary" />

            <ImageView
                android:id="@+id/miniVolumeButton"
                android:layout_width="@dimen/mini_icon_size"
                android:layout_height="@dimen/mini_icon_size"
                android:layout_marginStart="@dimen/form_margin_top"
                android:src="@drawable/ic_volume"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/miniFullscreenButton"
                android:layout_width="@dimen/mini_icon_size"
                android:layout_height="@dimen/mini_icon_size"
                android:layout_marginStart="@dimen/form_margin_top"
                android:src="@drawable/ic_fullscreen"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="@dimen/form_gap"
            android:paddingStart="@dimen/content_margin"
            android:paddingEnd="@dimen/content_margin">

            <TextView
                android:id="@+id/channelTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Sport 1"
                android:textSize="@dimen/text_channel_title"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary" />

            <TextView
                android:id="@+id/liveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/form_margin_top"
                android:background="@drawable/bg_badge"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="EN DIRECT"
                android:textSize="@dimen/text_badge"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/channelSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/form_gap"
            android:layout_marginBottom="@dimen/form_margin_top"
            android:paddingStart="@dimen/content_margin"
            android:text="Match de football"
            android:textSize="@dimen/text_body"
            android:textColor="@color/color_text_secondary" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Aucun contenu"
            android:textSize="@dimen/text_empty"
            android:textColor="@color/color_text_muted"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
