<?xml version="1.0" encoding="utf-8"?>
<!-- Zeno Play Series (approved reference): fixed sidebar, banner with
     poster image + title + rating/duration/year/genres + description +
     "Watch Now" / "Add to List" buttons, genre chips, "Trending Series"
     and "Drama & Fantasy" rows with ratings on the posters. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/zeno_bg"
    android:padding="@dimen/screen_padding">

    <com.mhplayer.app.ui.SidebarView
        android:id="@+id/sidebar"
        android:layout_width="@dimen/sidebar_width"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/content_margin_left">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Banner -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/banner_height">

                <ImageView
                    android:id="@+id/bannerImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/poster_placeholder"
                    android:contentDescription="@null" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_scrim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/bannerTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Series"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/zeno_text_primary" />

                    <TextView
                        android:id="@+id/bannerMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/zeno_gold" />

                    <TextView
                        android:id="@+id/bannerDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins"
                        android:textColor="@color/zeno_text_secondary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/watchNowButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:text="@string/movies_watch_now"
                            android:focusable="true"
                            style="@style/Widget.Zeno.Button.Primary" />

                        <Button
                            android:id="@+id/addToListButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="12dp"
                            android:paddingStart="24dp"
                            android:paddingEnd="24dp"
                            android:text="@string/movies_add_list"
                            android:focusable="true"
                            style="@style/Widget.Zeno.Button.Secondary" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Genre chips -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chipList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal" />

            <!-- Row 1 -->
            <TextView
                android:id="@+id/row1Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/series_trending"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textColor="@color/zeno_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/row1List"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />

            <!-- Row 2 -->
            <TextView
                android:id="@+id/row2Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/series_drama"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textColor="@color/zeno_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/row2List"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/vod_no_poster"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/zeno_text_muted"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
