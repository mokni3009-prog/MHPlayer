<?xml version="1.0" encoding="utf-8"?>
<!-- Series poster card: image on top + dark label bar below (radius 12dp top corners only on the image). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/selector_focusable"
    android:padding="2dp"
    android:focusable="true"
    android:clickable="true">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/posterImage"
            android:layout_width="@dimen/poster_width_land"
            android:layout_height="@dimen/poster_height_land"
            android:scaleType="centerCrop"
            android:background="@drawable/poster_placeholder"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/posterRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_rating_badge"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="★ 8.5"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:textColor="@color/zeno_gold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/posterTitle"
        android:layout_width="@dimen/poster_width_land"
        android:layout_height="@dimen/episode_label_height"
        android:gravity="center"
        android:background="@drawable/bg_episode_label"
        android:textSize="@dimen/text_poster_title"
        android:textStyle="bold"
        android:textColor="@color/zeno_text_primary"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
