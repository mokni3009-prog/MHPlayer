<?xml version="1.0" encoding="utf-8"?>
<!-- Zeno Play loading screen (approved reference): Z logo + "Zeno Play" in
     gold + tagline, thin gold->cyan progress bar, "Loading Xtream Codes..."
     below. ScrollView keeps everything reachable on short phone screens. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="112dp"
            android:layout_marginTop="48dp"
            android:src="@drawable/logo_zeno"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:textColor="@color/zeno_gold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_tagline"
            android:textSize="14sp"
            android:fontFamily="@font/poppins"
            android:textColor="@color/zeno_text_secondary" />

        <ProgressBar
            android:id="@+id/loadingProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="@dimen/loading_bar_width"
            android:layout_height="6dp"
            android:layout_marginTop="48dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_progress_bar" />

        <TextView
            android:id="@+id/loadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/loading_text"
            android:textSize="14sp"
            android:fontFamily="@font/poppins"
            android:textColor="@color/zeno_text_secondary" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/error_generic"
            android:textSize="14sp"
            android:fontFamily="@font/poppins"
            android:textColor="#FF6B6B"
            android:visibility="gone" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="16dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/retry"
            android:visibility="gone"
            style="@style/Widget.Zeno.Button.Primary" />

    </LinearLayout>
</ScrollView>
