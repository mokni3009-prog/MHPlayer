<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/episode_thumb_width"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/selector_focusable"
    android:padding="2dp"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/episodeThumb"
        android:layout_width="@dimen/episode_thumb_width"
        android:layout_height="@dimen/episode_thumb_height"
        android:scaleType="centerCrop"
        android:background="@drawable/poster_placeholder"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/episodeLabel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/episode_label_height"
        android:gravity="center"
        android:background="@drawable/bg_episode_label"
        android:textSize="@dimen/text_poster_title"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary"
        android:maxLines="1"
        android:ellipsize="end" />

</LinearLayout>
