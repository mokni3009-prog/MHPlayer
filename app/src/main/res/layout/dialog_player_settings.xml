<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_modern"
    android:padding="@dimen/card_padding">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Player"
        android:textSize="@dimen/text_dialog_title"
        android:textStyle="bold"
        android:textColor="@color/zeno_text_primary" />

    <RadioGroup
        android:id="@+id/engineGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/form_gap">

        <RadioButton
            android:id="@+id/engineAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto"
            android:textColor="@color/zeno_text_primary" />

        <RadioButton
            android:id="@+id/engineExo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_gap"
            android:text="ExoPlayer"
            android:textColor="@color/zeno_text_primary" />

        <RadioButton
            android:id="@+id/engineVlc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_gap"
            android:text="VLC"
            android:textColor="@color/zeno_text_primary" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/form_margin_top"
        android:text="Quality"
        android:textSize="@dimen/text_dialog_title"
        android:textStyle="bold"
        android:textColor="@color/zeno_text_primary" />

    <RadioGroup
        android:id="@+id/qualityGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/form_gap">

        <RadioButton
            android:id="@+id/qualityAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto"
            android:textColor="@color/zeno_text_primary" />

        <RadioButton
            android:id="@+id/quality1080"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_gap"
            android:text="1080p"
            android:textColor="@color/zeno_text_primary" />

        <RadioButton
            android:id="@+id/quality720"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_gap"
            android:text="720p"
            android:textColor="@color/zeno_text_primary" />

        <RadioButton
            android:id="@+id/quality480"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_gap"
            android:text="480p"
            android:textColor="@color/zeno_text_primary" />
    </RadioGroup>

    <TextView
        android:id="@+id/containerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/form_margin_top"
        android:text="Format"
        android:textSize="@dimen/text_dialog_title"
        android:textStyle="bold"
        android:textColor="@color/zeno_text_primary" />

    <RadioGroup
        android:id="@+id/containerGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/form_gap">

        <RadioButton
            android:id="@+id/containerAuto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto"
            android:textColor="@color/zeno_text_primary" />

        <RadioButton
            android:id="@+id/containerHls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_gap"
            android:text="HLS"
            android:textColor="@color/zeno_text_primary" />

        <RadioButton
            android:id="@+id/containerTs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/form_gap"
            android:text="TS"
            android:textColor="@color/zeno_text_primary" />
    </RadioGroup>

    <Button
        android:id="@+id/settingsOkButton"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginTop="@dimen/form_margin_top"
        android:text="OK"
        style="@style/Widget.Zeno.Button.Primary" />
</LinearLayout>
