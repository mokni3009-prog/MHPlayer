<?xml version="1.0" encoding="utf-8"?>
<!-- Shared narrow sidebar (DESIGN_TOKENS.md §1.4): logo + menu, "Ma playlist" pinned at the bottom. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/sidebarLogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/sidebarLogoIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/logo_play"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/sidebarLogoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="MH Player"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sidebarMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/itemHome"
            layout="@layout/item_sidebar" />

        <include
            android:id="@+id/itemChannels"
            layout="@layout/item_sidebar" />

        <include
            android:id="@+id/itemMovies"
            layout="@layout/item_sidebar" />

        <include
            android:id="@+id/itemSeries"
            layout="@layout/item_sidebar" />
    </LinearLayout>

    <View
        android:id="@+id/sidebarSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include
        android:id="@+id/itemPlaylist"
        layout="@layout/item_sidebar" />

</merge>
