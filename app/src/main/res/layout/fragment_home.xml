<?xml version="1.0" encoding="utf-8"?>
<!-- Zeno Play Home (approved reference): fixed sidebar, search icon +
     profile avatar top-right, "Featured Live Channels" (horizontal cards
     with LIVE badge), "Continue Watching" and "New Releases" poster rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/zeno_bg"
    android:padding="@dimen/screen_padding">

    <com.mhplayer.app.ui.SidebarView
        android:id="@+id/sidebar"
        android:layout_width="@dimen/sidebar_width"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/content_margin_left">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top bar: search + profile -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/searchButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="11dp"
                    android:src="@drawable/ic_search"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/profileAvatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_icon_circle"
                    android:padding="10dp"
                    android:src="@drawable/ic_user"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/home_featured"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textColor="@color/zeno_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/featuredList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/featuredEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_no_featured"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/zeno_text_muted"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/home_continue"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textColor="@color/zeno_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/continueList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/continueEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_no_continue"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/zeno_text_muted"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/home_new"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:textColor="@color/zeno_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/newList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/newEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_no_new"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/zeno_text_muted"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
