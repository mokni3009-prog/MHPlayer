<?xml version="1.0" encoding="utf-8"?>
<!-- Search dialog (Home / Movies / Series search icon): an input + a
     vertical results list (channels, movies, series). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_modern"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins"
        android:textColor="@color/zeno_text_primary" />

    <EditText
        android:id="@+id/searchInput"
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:layout_marginTop="12dp"
        android:hint="@string/home_search_hint"
        android:inputType="text"
        android:maxLines="1"
        style="@style/Widget.Zeno.Input" />

    <TextView
        android:id="@+id/searchHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/search_empty"
        android:textSize="13sp"
        android:fontFamily="@font/poppins"
        android:textColor="@color/zeno_text_muted" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/searchResults"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="8dp" />

</LinearLayout>
