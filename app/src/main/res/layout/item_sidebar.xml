<?xml version="1.0" encoding="utf-8"?>
<!-- One sidebar menu row (v1.6): icon + bold label. The selected row gets the
     slate gradient pill background (@drawable/bg_sidebar_selected) and a gold
     icon; unselected rows are transparent with muted icons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/sidebar_item_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/sidebarItemIcon"
        android:layout_width="@dimen/sidebar_item_icon"
        android:layout_height="@dimen/sidebar_item_icon"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/sidebarItemLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/sidebar_item_gap"
        android:textSize="@dimen/text_sidebar_label"
        android:textStyle="bold"
        android:fontFamily="@font/poppins"
        android:textColor="@color/zeno_text_secondary" />

</LinearLayout>
