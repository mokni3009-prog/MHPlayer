<?xml version="1.0" encoding="utf-8"?>
<!-- Login — modern redesign (v1.4, designer graphique): gradient background
     with a soft red glow, glass card, red logo badge, segmented pill tabs,
     modern inputs with icons and a red focus border, gradient CTA button.
     Same content as the approved screen: 2 tabs, 4 Xtream fields + 2 M3U
     fields, red "Se connecter". Responsive (v1.3): card 0dp wide, 24dp side
     margins, 530dp max width, ScrollView keeps the form reachable. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_modern"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="20dp"
                android:paddingBottom="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintWidth_max="@dimen/login_card_width"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp">

                <!-- Logo badge + wordmark + tagline -->
                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_logo_badge">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:src="@drawable/logo_play_white"
                        android:contentDescription="@null" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:text="MH Player"
                    android:textSize="@dimen/text_logo"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:text="Votre IPTV, partout."
                    android:textSize="14sp"
                    android:textColor="@color/color_text_muted" />

                <!-- Segmented pill tabs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_tab_container"
                    android:padding="4dp">

                    <LinearLayout
                        android:id="@+id/tabXtream"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_tab_pill_active"
                        android:focusable="true"
                        android:clickable="true">

                        <TextView
                            android:id="@+id/tabXtreamLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Xtream Codes"
                            android:textSize="@dimen/text_tab"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tabM3u"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_tab_pill_inactive"
                        android:focusable="true"
                        android:clickable="true">

                        <TextView
                            android:id="@+id/tabM3uLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Playlist M3U"
                            android:textSize="@dimen/text_tab"
                            android:textColor="@color/color_text_muted" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Xtream Codes form -->
                <LinearLayout
                    android:id="@+id/formXtream"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Serveur (URL)"
                        android:textSize="@dimen/text_label"
                        android:textColor="@color/color_text_secondary" />

                    <EditText
                        android:id="@+id/inputServer"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/form_gap"
                        android:hint="https://serveur.example.com"
                        android:inputType="textUri"
                        android:drawableStart="@drawable/ic_globe"
                        style="@style/Widget.MHPlayer.Input.Modern" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Nom d'utilisateur"
                        android:textSize="@dimen/text_label"
                        android:textColor="@color/color_text_secondary" />

                    <EditText
                        android:id="@+id/inputUsername"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/form_gap"
                        android:hint="ex: utilisateur123"
                        android:inputType="text"
                        android:drawableStart="@drawable/ic_user"
                        style="@style/Widget.MHPlayer.Input.Modern" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Mot de passe"
                        android:textSize="@dimen/text_label"
                        android:textColor="@color/color_text_secondary" />

                    <EditText
                        android:id="@+id/inputPassword"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/form_gap"
                        android:hint="••••••••••"
                        android:inputType="textPassword"
                        android:drawableStart="@drawable/ic_lock"
                        style="@style/Widget.MHPlayer.Input.Modern" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Nom de la playlist"
                        android:textSize="@dimen/text_label"
                        android:textColor="@color/color_text_secondary" />

                    <EditText
                        android:id="@+id/inputPlaylistName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/form_gap"
                        android:hint="ex: Ma playlist"
                        android:inputType="text"
                        android:drawableStart="@drawable/ic_list"
                        style="@style/Widget.MHPlayer.Input.Modern" />
                </LinearLayout>

                <!-- Playlist M3U form -->
                <LinearLayout
                    android:id="@+id/formM3u"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="URL de la playlist"
                        android:textSize="@dimen/text_label"
                        android:textColor="@color/color_text_secondary" />

                    <EditText
                        android:id="@+id/inputM3uUrl"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/form_gap"
                        android:hint="https://serveur.example.com/playlist.m3u"
                        android:inputType="textUri"
                        android:drawableStart="@drawable/ic_globe"
                        style="@style/Widget.MHPlayer.Input.Modern" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Nom de la playlist"
                        android:textSize="@dimen/text_label"
                        android:textColor="@color/color_text_secondary" />

                    <EditText
                        android:id="@+id/inputM3uPlaylistName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/form_gap"
                        android:hint="ex: Ma playlist"
                        android:inputType="text"
                        android:drawableStart="@drawable/ic_list"
                        style="@style/Widget.MHPlayer.Input.Modern" />
                </LinearLayout>

                <Button
                    android:id="@+id/loginButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="Se connecter"
                    style="@style/Widget.MHPlayer.Button.PrimaryModern" />

                <ProgressBar
                    android:id="@+id/loginProgress"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/form_gap"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/errorText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/form_gap"
                    android:gravity="center"
                    android:textSize="@dimen/text_error"
                    android:textColor="@color/color_primary_red"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/loginFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Connexion Xtream Codes"
                    android:textSize="@dimen/text_footer"
                    android:textColor="@color/color_text_muted" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</FrameLayout>
