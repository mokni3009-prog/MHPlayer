<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/list_row_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/list_item_padding"
    android:paddingEnd="@dimen/list_item_padding"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/channelLogo"
        android:layout_width="@dimen/list_item_icon"
        android:layout_height="@dimen/list_item_icon"
        android:scaleType="centerCrop"
        android:background="@drawable/poster_placeholder"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/channelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:textSize="@dimen/text_list_item"
        android:textStyle="bold"
        android:fontFamily="@font/poppins"
        android:textColor="@color/zeno_text_primary"
        android:maxLines="1"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee"
        android:focusable="true"
        android:focusableInTouchMode="true" />

</LinearLayout>
