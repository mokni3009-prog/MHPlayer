<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <com.mhplayer.app.ui.SidebarView
        android:id="@+id/sidebar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="40dp"
        android:paddingEnd="32dp"
        android:paddingTop="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/screenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ma playlist"
                android:textSize="48sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary" />

            <!-- Header card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:padding="24dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/color_primary_red" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="24dp">

                    <TextView
                        android:id="@+id/playlistName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ma playlist"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_primary" />

                    <TextView
                        android:id="@+id/serverInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Serveur : — • Premium"
                        android:textSize="18sp"
                        android:textColor="@color/color_text_secondary" />

                    <TextView
                        android:id="@+id/updatedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Dernière mise à jour : aujourd'hui"
                        android:textSize="16sp"
                        android:textColor="@color/color_text_muted" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/statChannelsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="chaînes"
                            android:textSize="18sp"
                            android:textColor="@color/color_text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginStart="96dp">

                        <TextView
                            android:id="@+id/statMoviesValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="films"
                            android:textSize="18sp"
                            android:textColor="@color/color_text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:layout_marginStart="96dp">

                        <TextView
                            android:id="@+id/statSeriesValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="séries"
                            android:textSize="18sp"
                            android:textColor="@color/color_text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Chaînes"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelTiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Films"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/filmThumbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Séries"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/color_text_primary" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/seriesThumbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:text="Aucun contenu"
                android:textSize="20sp"
                android:textColor="@color/color_text_muted"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
