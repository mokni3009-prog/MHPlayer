<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/chip_height"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingStart="@dimen/chip_padding"
    android:paddingEnd="@dimen/chip_padding"
    android:background="@drawable/bg_chip_unselected"
    android:focusable="true"
    android:clickable="true">

    <TextView
        android:id="@+id/chipLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_chip"
        android:textStyle="bold"
        android:textColor="@color/color_text_primary" />

</LinearLayout>
