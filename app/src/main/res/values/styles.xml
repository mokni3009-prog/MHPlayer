<?xml version="1.0" encoding="utf-8"?>
<!-- Zeno Play styles (v1.6): Poppins everywhere, bold and readable from far. -->
<resources>
    <!-- Required by AndroidManifest.xml (android:theme="@style/Theme.MHPlayer"). -->
    <style name="Theme.MHPlayer" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/zeno_gold</item>
        <item name="colorPrimaryDark">@color/zeno_bg_deep</item>
        <item name="colorAccent">@color/zeno_cyan</item>
        <item name="android:windowBackground">@color/zeno_bg</item>
        <item name="android:textColorPrimary">@color/zeno_text_primary</item>
        <item name="android:textColorSecondary">@color/zeno_text_secondary</item>
        <item name="android:statusBarColor">@color/zeno_bg</item>
        <item name="android:navigationBarColor">@color/zeno_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
    </style>

    <!-- Dialog theme (update dialog, player settings dialog). -->
    <style name="Theme.MHPlayer.Dialog" parent="Theme.AppCompat.Dialog">
        <item name="colorPrimary">@color/zeno_gold</item>
        <item name="colorAccent">@color/zeno_cyan</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:textColorPrimary">@color/zeno_text_primary</item>
        <item name="android:textColorSecondary">@color/zeno_text_secondary</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
    </style>

    <!-- Text styles (all Poppins; titles bold, body semibold).
         Base parents are required: AAPT resolves the implicit dot-parent
         of every Text.Zeno.* / Widget.Zeno.* style at link time. -->
    <style name="Text.Zeno">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/zeno_text_primary</item>
    </style>

    <style name="Widget.Zeno" />

    <style name="Text.Zeno.Title">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/zeno_text_primary</item>
    </style>

    <style name="Text.Zeno.SectionTitle">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/zeno_text_primary</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Text.Zeno.Body">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/zeno_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Zeno.BodyBold">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/zeno_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Zeno.Hint">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textColor">@color/zeno_text_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Text.Zeno.SidebarItem">
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/zeno_text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Primary button: gold -> cyan gradient, dark bold text. -->
    <style name="Widget.Zeno.Button.Primary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary_modern</item>
        <item name="android:textColor">@color/zeno_text_on_gradient</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Secondary button: navy panel with border. -->
    <style name="Widget.Zeno.Button.Secondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/zeno_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Modern input: navy fill, thin border, cyan border when focused. -->
    <style name="Widget.Zeno.Input">
        <item name="android:background">@drawable/bg_input_modern_selector</item>
        <item name="android:textColor">@color/zeno_text_primary</item>
        <item name="android:textColorHint">@color/zeno_text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:paddingBottom">15dp</item>
    </style>

    <!-- Gold -> cyan switch (settings). -->
    <style name="Widget.Zeno.Switch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/thumb_switch_zeno</item>
        <item name="android:track">@drawable/track_switch_zeno</item>
    </style>

    <!-- Ghost button: transparent with a border (dialog "Later"). -->
    <style name="Widget.Zeno.Button.Ghost" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/zeno_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Legacy style names kept for compatibility with v1.5 layouts that
         are not rewritten in v1.6 (they now point at the Zeno drawables). -->
    <style name="Widget.MHPlayer.Button.Ghost" parent="Widget.Zeno.Button.Ghost" />
    <style name="Widget.MHPlayer.Button.PrimaryModern" parent="Widget.Zeno.Button.Primary" />
    <style name="Widget.MHPlayer.Button.Primary" parent="Widget.Zeno.Button.Primary" />
    <style name="Widget.MHPlayer.Button.Secondary" parent="Widget.Zeno.Button.Secondary" />
    <style name="Widget.MHPlayer.Input" parent="Widget.Zeno.Input" />
</resources>
