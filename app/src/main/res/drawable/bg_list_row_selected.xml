<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/zeno_selected_bg" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item
        android:width="4dp"
        android:top="6dp"
        android:bottom="6dp"
        android:gravity="left">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="@color/zeno_gold"
                android:endColor="@color/zeno_cyan"
                android:type="linear" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
