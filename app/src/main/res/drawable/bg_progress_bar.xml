<?xml version="1.0" encoding="utf-8"?>
<!-- Loading progress bar (v1.4 redesign): dark track, red gradient fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_track" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="@color/color_red_gradient_start"
                    android:endColor="@color/color_red_gradient_end"
                    android:type="linear" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
</layer-list>
